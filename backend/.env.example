PORT=3000
# Azure SQL Database
DB_SERVER=<tu-servidor>.database.windows.net
DB_PORT=1433
DB_NAME=<tu-base>
DB_USER=<usuario-admin>
DB_PASSWORD=__coloca_aqui_la_contraseña__
DB_ENCRYPT=true
DB_TRUST_CERT=false
# Firma de los tokens de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=__cadena_larga_aleatoria__
# Si el frontend se publica en otro dominio, ponlo aquí (separados por coma). * = cualquiera
CORS_ORIGINS=*
